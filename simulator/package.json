{
  "name": "bamboo-sup-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hydrostatics and geometry for the bamboo SUP. Physics is headless and must not import Three.js.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "report": "vite-node scripts/report.ts",
    "views": "vite-node scripts/views.ts",
    "dev": "vite",
    "build": "vite build",
    "scene": "vite --config vite.scene.config.ts",
    "build:scene": "vite build --config vite.scene.config.ts"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "three": "^0.185.1",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
